{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/en/toyota/7fd25",
      "destination": "/toyota7fd25-overseas-rfq.html"
    },
    {
      "source": "/en/toyota/7fd25/front-drive-axle",
      "destination": "/toyota7fd25-overseas-rfq.html"
    },
    {
      "source": "/en/toyota/7fd25/front-drive-axle/:slug",
      "destination": "/toyota7fd25-overseas-rfq.html?part=:slug"
    },
    {
      "source": "/en/parts/:oem",
      "destination": "/toyota7fd25-overseas-rfq.html?part=:oem"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
